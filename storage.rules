rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Anexos (comprovantes, fotos, documentos): até 20 MB, só PDF e imagens, só para editores e administradores
    match /anexos/{arquivo=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 20 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/png|image/jpeg|image/webp')
        && firestore.get(/databases/(default)/documents/usuarios/$(request.auth.token.email.lower())).data.papel in ['admin', 'editor'];
    }
  }
}
